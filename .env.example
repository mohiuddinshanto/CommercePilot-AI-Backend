# Database
MONGODB_URI=your_mongodb_connection_string
DB_NAME=your_database_name

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:5000

# Client
CLIENT_URL=http://localhost:3000

# Additional CORS origins (comma-separated, e.g. https://preview.vercel.app)
ALLOWED_ORIGINS=

# Server
PORT=5000

# AI
GROQ_API_KEY=your_groq_api_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (Nodemailer - Gmail App Password recommended)
# Step 1: Enable 2-Factor Authentication on your Google account
# Step 2: Go to myaccount.google.com/apppasswords → create an App Password
# Step 3: Paste the 16-char App Password below (no spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=CommercePilot <your_gmail@gmail.com>